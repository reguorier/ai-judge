// P0-F: Report overlay with null check
function openParliamentReportOverlay() {
  if (!state.currentVerdict && !state.workflow?.currentVerdict) {
    const msg = document.createElement("div");
    msg.style.cssText = "position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:white;padding:24px 32px;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.2);z-index:9999;font-size:15px;";
    msg.innerHTML = "<p>报告尚未生成。请先运行裁决，完成后报告将自动生成。</p><button onclick=\"this.parentElement.remove()\" style=\"margin-top:12px;padding:8px 16px;border:1px solid #e5e7eb;border-radius:6px;cursor:pointer\">知道了</p>";
    document.body.appendChild(msg);
    return;
  }
  const verdict = state.currentVerdict || state.workflow?.currentVerdict;
  const runId = verdict?.run_id || state.currentRunId;
  if (runId) {
    const url = `${window.location.origin}/api/runs/${runId}/index.html`;
    window.open(url, "_blank");
  }
}
